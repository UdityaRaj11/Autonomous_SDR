# Autonomous SDR Engine Environment Configuration
# Optional: Set your Groq API Key to enable live LPU inference (llama-3.3-70b and llama-3.1-8b)
# If omitted or empty, the application runs in high-speed deterministic simulation mode.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Port binding (automatically injected on Render, Hugging Face, or Railway)
PORT=8000
